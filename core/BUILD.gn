import("//testing/test.gni")
import("sdb/sdbd.gni")

group("core_all") {
  deps = [
    ":core",
    ":demo_map_data",
    "//core/sdbd_client",
    "//core/mapd_client",
  ]
}

# Default demo: world GeoJSON (point/line/polygon) plus Shanghai shapefile fallback.
action("demo_map_data") {
  script = "//core/copy_demo_data.py"
  sources = [
    "data/sh/POLYGON.dbf",
    "data/sh/POLYGON.prj",
    "data/sh/POLYGON.shp",
    "data/sh/POLYGON.shx",
    "data/world/countries.geojson",
    "data/world/graticule.geojson",
    "data/world/capitals.geojson",
  ]
  outputs = [
    "$root_out_dir/data/sh/POLYGON.dbf",
    "$root_out_dir/data/sh/POLYGON.prj",
    "$root_out_dir/data/sh/POLYGON.shp",
    "$root_out_dir/data/sh/POLYGON.shx",
    "$root_out_dir/data/world/countries.geojson",
    "$root_out_dir/data/world/graticule.geojson",
    "$root_out_dir/data/world/capitals.geojson",
  ]
  args = [
    rebase_path("data/sh/POLYGON.dbf", root_build_dir),
    rebase_path("$root_out_dir/data/sh/POLYGON.dbf", root_build_dir),
    rebase_path("data/sh/POLYGON.prj", root_build_dir),
    rebase_path("$root_out_dir/data/sh/POLYGON.prj", root_build_dir),
    rebase_path("data/sh/POLYGON.shp", root_build_dir),
    rebase_path("$root_out_dir/data/sh/POLYGON.shp", root_build_dir),
    rebase_path("data/sh/POLYGON.shx", root_build_dir),
    rebase_path("$root_out_dir/data/sh/POLYGON.shx", root_build_dir),
    rebase_path("data/world/countries.geojson", root_build_dir),
    rebase_path("$root_out_dir/data/world/countries.geojson", root_build_dir),
    rebase_path("data/world/graticule.geojson", root_build_dir),
    rebase_path("$root_out_dir/data/world/graticule.geojson", root_build_dir),
    rebase_path("data/world/capitals.geojson", root_build_dir),
    rebase_path("$root_out_dir/data/world/capitals.geojson", root_build_dir),
  ]
}

static_library("core") {
  defines = [
    "NOMINMAX",
    "USE_UNSTABLE_GEOS_CPP_API",
  ]

  sources = [
    "geometry/geometry.cpp",
    "sdb/sdb.cpp",
  ]

  # sdbd
  sources += sdbd_sources

  include_dirs += [
    "$root_gen_dir/",
  ]

  libs = [
    "winhttp.lib",
  ]

  public_deps = [
    "//core/sdbd_client",
    "//core/mapd_client",
  ]

  deps = [
    "//base:base",
    "//third_party:sqlite3",
    "//third_party:SQLiteCpp",
    "//third_party:geos",
    "//third_party:gdal",
  ]
}

test("core_test") {
  defines = [
    "NOMINMAX",
    "USE_UNSTABLE_GEOS_CPP_API",
  ]

  sources = [
    "core_unittest.cpp",
    "geometry/geometry_unittest.cpp",
    "sdb/sdb_unittest.cpp",
    "sdb/sdbd_unittest.cpp",
  ]

  include_dirs += [
    "$root_gen_dir/",
  ]

  libs = [
    "ws2_32.lib",
  ]

  deps = [
    ":core",
    "//third_party:sqlite3",
    "//third_party:SQLiteCpp",
    "//third_party:geos",
    "//third_party:PROJ",
    "//third_party:gdal",
    "//third_party:runtime_dlls_beside_exe",
  ]
}