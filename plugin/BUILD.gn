# In-process plugin catalog and DLL loader.

config("plugin_includes") {
  include_dirs += [ "//" ]
}

static_library("plugin") {
  sources = [
    "contribute.cc",
    "contribute.h",
    "loader.cc",
    "loader.h",
    "registry.cc",
    "registry.h",
    "api/mview_plugin_api.h",
  ]
  include_dirs += [ "//" ]
  public_configs = [ ":plugin_includes" ]
  deps = [
    "//base:base",
    "//content:content",
  ]
}

shared_library("plugin_sample") {
  sources = [ "sample/plugin_sample.cc" ]
  include_dirs += [ "//" ]
  output_name = "plugin_sample"
}

executable("plugin_sample_test") {
  testonly = true
  sources = [ "../testing/plugin/p6_harness_test.cc" ]
  deps = [
    ":plugin",
    ":plugin_sample",
    "//content:content",
    "//testing:gtest",
    "//testing:gtest_main",
  ]
  include_dirs += [ "//testing/gtest/include" ]
  if (is_win) {
    configs += [ "//build/config/win:console_subsystem" ]
  }
}
