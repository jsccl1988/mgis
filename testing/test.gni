# Compatible with smartgis third_party overlays that import this file.
# test() links //testing:gtest (Chromium snapshot), not //third_party:gtest.

template("test") {
  executable(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "configs",
                             "deps",
                             "use_gtest",
                           ])
    testonly = true
    if (defined(invoker.configs)) {
      configs += invoker.configs
    }

    _deps = []
    if (defined(invoker.deps)) {
      _deps += invoker.deps
    }
    _use_gtest = true
    if (defined(invoker.use_gtest)) {
      _use_gtest = invoker.use_gtest
    }
    if (_use_gtest) {
      _deps += [
        "//testing:gtest",
        "//testing:gtest_main",
      ]
    }
    deps = _deps
  }
}
