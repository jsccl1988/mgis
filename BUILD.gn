# Root groups: all / default / m. Default builds product demos under
# //ui/views/examples plus //app/ui_designer.

group("all") {
  deps = [
    "//app/ui_designer:ui_designer",
    "//ui/views/examples:product_examples",
  ]
}

group("default") {
  deps = [ ":all" ]
}

group("m") {
  deps = [ ":all" ]
}

# P0 tool dispatch. Not part of the product group, so default stays base_widget.
group("tool_tests") {
  testonly = true
  deps = [ "//tool:tool_dispatch_test" ]
}

# GIS content library. Not part of //:default. ninja target: content.
group("content_lib") {
  deps = [ "//content:content" ]
}

# Compat aliases for former shell / launcher group names.
# Product PE is //app/mgis:mgis (mgis.exe). ninja / build.bat: mgis
group("shell") {
  deps = [ "//app/mgis:mgis" ]
}

group("launcher") {
  deps = [ "//app/mgis:mgis" ]
}

# P2/P4 pipe gate. Not part of //:default. ninja target: viewport_gate.
group("viewport_gate_tests") {
  testonly = true
  deps = [ "//content:viewport_gate" ]
}

# P6 plugin and pick verifiers. Not part of //:default.
group("plugin_tests") {
  testonly = true
  deps = [ "//plugin:plugin_sample_test" ]
}

# P6 and P7 verifiers together. Not part of //:default.
group("p6_p7") {
  testonly = true
  deps = [
    "//plugin:plugin_sample_test",
    "//app/mgis:mgis",
  ]
}

# P5 volume and wind. Not part of the product group, so default stays base_widget.
group("volume_tests") {
  testonly = true
  deps = [ "//third_party/vtk/mview_volume:volume_field_test" ]
}

# P3 map camera / MapPass tests. Not part of //:default.
group("mview_map_tests") {
  testonly = true
  deps = [ "//vista:vista_tests" ]
}

group("vista_tests") {
  testonly = true
  deps = [ "//vista:vista_tests" ]
}

# Vista render-engine layer (MapPass + WorldPass).
group("vista") {
  deps = [ "//vista:vista" ]
}
