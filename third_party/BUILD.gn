# Test and console binaries statically import gdald/geos. The desktop exe
# calls DirectoryAsDLLSearchPath(third_party/bin) before LoadLibrary; tests
# cannot — the loader fails before main (0xC0000135) unless these sit in out/.
# GN copy() uses cmd `copy` which this ninja cannot CreateProcess.
action("runtime_dlls_beside_exe") {
  script = "//core/copy_demo_data.py"
  postfix = ""
  proj_postfix = ""
  if (is_debug) {
    postfix = "d"
    proj_postfix = "_d"
  }
  _bin = "$third_party_install_prefix/bin"
  sources = [
    "$_bin/gdal$postfix.dll",
    "$_bin/geos.dll",
    "$_bin/geos_c.dll",
    "$_bin/proj_9_4$proj_postfix.dll",
  ]
  outputs = [
    "$root_out_dir/gdal$postfix.dll",
    "$root_out_dir/geos.dll",
    "$root_out_dir/geos_c.dll",
    "$root_out_dir/proj_9_4$proj_postfix.dll",
  ]
  args = [
    rebase_path("$_bin/gdal$postfix.dll", root_build_dir),
    rebase_path("$root_out_dir/gdal$postfix.dll", root_build_dir),
    rebase_path("$_bin/geos.dll", root_build_dir),
    rebase_path("$root_out_dir/geos.dll", root_build_dir),
    rebase_path("$_bin/geos_c.dll", root_build_dir),
    rebase_path("$root_out_dir/geos_c.dll", root_build_dir),
    rebase_path("$_bin/proj_9_4$proj_postfix.dll", root_build_dir),
    rebase_path("$root_out_dir/proj_9_4$proj_postfix.dll", root_build_dir),
  ]
  deps = [
    ":PROJ",
    ":gdal",
    ":geos",
  ]
}

group("third_party_all") {
  deps = [ "//third_party/gn:third_party_all" ]
}
