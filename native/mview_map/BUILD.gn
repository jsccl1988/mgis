# 2D map ABI and follow-2d zoom table. Not part of //:default.
# MapLibre Native is not linked. The DLL keeps an in-memory camera.

config("export_defines") {
  defines = [ "MVIEW_MAP_BUILD" ]
}

static_library("mview_map_math") {
  sources = [
    "camera_follow.cc",
    "camera_follow.h",
  ]
}

shared_library("mview_map") {
  output_name = "mview_map"
  sources = [
    "map_surface.cc",
    "map_surface.h",
    "mview_map.cc",
    "mview_map.h",
  ]
  deps = [ ":mview_map_math" ]
  configs += [ ":export_defines" ]
  libs = [
    "gdi32.lib",
    "opengl32.lib",
    "user32.lib",
  ]
}

executable("mview_map_test") {
  testonly = true
  sources = [ "mview_map_test.cc" ]
  deps = [
    ":mview_map",
    ":mview_map_math",
    "//testing:gtest",
    "//testing:gtest_main",
    "//tool:tool",
  ]
  include_dirs += [ "//testing/gtest/include" ]
  if (is_win) {
    configs += [ "//build/config/win:console_subsystem" ]
  }
}
