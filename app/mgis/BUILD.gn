# Product workbench: Mgis main window and horizon panels.

static_library("mgis") {
  sources = [
    "horizon/bottom_panel.cc",
    "horizon/bottom_panel.h",
    "horizon/catalog_tabs.cc",
    "horizon/catalog_tabs.h",
    "horizon/map_toolbar.cc",
    "horizon/map_toolbar.h",
    "horizon/status_bar.cc",
    "horizon/status_bar.h",
    "horizon/tool_plugin_panel.cc",
    "horizon/tool_plugin_panel.h",
    "horizon/viewport_placeholder.cc",
    "horizon/viewport_placeholder.h",
    "session/session.cc",
    "session/session.h",
    "view_id.h",
    "viewport/globe_view.cc",
    "viewport/globe_view.h",
    "viewport/viewport_surface.cc",
    "viewport/viewport_surface.h",
    "workbench/workbench.cc",
    "workbench/workbench.h",
    "workbench/workbench_markup.cc",
    "workbench/workbench_markup.h",
  ]
  deps = [
    "//base:base",
    "//base:base_i18n",
    "//content:content",
    "//content:product_presenters",
    "//plugin:plugin",
    "//plugin:plugin_sample",
    "//build/grit:headers",
    "//skia:skia",
    "//ui/views:views",
    "//ui:ui",
    "//ui:ui_resources",
  ]
  defines += [
    "_WIN32_WINNT=0x0602",
    "WINVER=0x0602",
    "WIN32",
    "_WINDOWS",
    "NOMINMAX",
    "TOOLKIT_VIEWS=1",
    "CHROMIUM_BUILD",
    "_HAS_EXCEPTIONS=0",
  ]
  include_dirs += [
    "//.",
    "//skia/config",
    "//third_party/skia/include/core",
    "//third_party/skia/include/config",
  ]
  libs = [ "opengl32.lib" ]
  configs += [ "//build/config:precompile" ]
}
